{
  "name": "aerospacer",
  "description": "A TypeScript CLI for aerospace utilities",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "aerospacer": "dist/index.js"
  },
  "author": "carlba",
  "homepage": "https://github.com/carlba/aerospacer",
  "bugs": {
    "url": "https://github.com/carlba/aerospacer"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:carlba/aerospacer"
  },
  "scripts": {
    "build": "tsc",
    "build-watch": "tsc --watch",
    "prepare": "npm run build",
    "start": "node --env-file-if-exists dist/index.js",
    "start:dev": "tsx --env-file-if-exists=.env --watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dependency:update": "npx ncu -u"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.2.1",
    "npm-check-updates": "^21.0.3",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.3.6"
  }
}
